# ============================================================
# Firstmom — environment variables
# Copy to .env (root) and fill in. Apps load their own .env from
# their working directory; root .env is for shared local notes.
# ============================================================

# Claude / AI Gateway — used by apps/api at chat time (M3)
ANTHROPIC_API_KEY=

# Postgres connection string — Neon serverless (M3)
DATABASE_URL=

# Where apps/mobile points its API calls.
#   - iOS sim + web:     http://localhost:3000
#   - Android emulator:  http://10.0.2.2:3000 (host loopback)
EXPO_PUBLIC_API_URL=http://localhost:3000
